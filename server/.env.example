# MPUZA - Supabase Configuration
# Get these from your Supabase dashboard: https://supabase.com/dashboard

# Your Supabase project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Client-safe key: either the new "publishable" key (sb_publishable_…) or the
# legacy anon JWT. Found in Project Settings > API.
SUPABASE_ANON_KEY=your-anon-key-here
# Or, equivalently, use the name Supabase shows in its dashboard:
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_…

# NEVER commit your secret/service key (sb_secret_…): it bypasses RLS.
# Only set it in the Vercel dashboard if a server-side feature ever needs it.

# Port the Express server runs on
PORT=4000
